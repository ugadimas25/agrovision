# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# runtime data (bukti upload lokal)
/.evidence/

# claude code local settings
.claude/settings.local.json
# Worktree sementara milik agent: berisi .next/ yang membuat lint melaporkan
# ribuan galat dari artefak build, bukan dari kode repo ini.
.claude/worktrees/

# aset besar — dilayani dari GCS / bisa diregenerasi (bikin repo terlalu berat untuk di-clone Cloud Build)
/public/tiles/
*.tif

# Tiket internal: memuat lokasi celah kontrol, JANGAN masuk repo publik
TIKET-*-INTERNAL.md

# Dump database lokal (pg_dump). Jangan di-commit: ukurannya besar dan isinya
# salinan data, bukan sumber kebenaran. Skema tetap dari db/migrations/, data
# demo tetap dari db/seed-demo.mjs.
/db/backups/

# Kredensial hasil scripts/setup-identity-platform.mjs -- JANGAN pernah di-commit.
identity-platform-credentials.txt
