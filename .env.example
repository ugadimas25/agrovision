# Salin ke .env.local lalu sesuaikan. JANGAN commit .env.local.

# --- Database ---
# Koneksi superuser -- dipakai db:migrate dan db:bootstrap, BUKAN oleh aplikasi.
# Lokal / VM (docker compose): lihat docker-compose.yml (port 55433).
MIGRATION_DATABASE_URL=postgres://postgres:dev@localhost:55433/agrovision

# Koneksi runtime aplikasi. HARUS sebagai app_user (anggota app_rw), bukan
# postgres -- append-only dan RLS ditegakkan lewat pencabutan hak pada role ini.
# app_user dibuat oleh `npm run db:bootstrap` dari dua variabel di bawah.
DATABASE_URL=postgres://app_user:GANTI_PASSWORD@localhost:55433/agrovision
APP_DB_USER=app_user
APP_DB_PASSWORD=GANTI_PASSWORD

# Maksimum koneksi pool aplikasi (default 10).
# DATABASE_POOL_MAX=10

# --- Session ---
# Wajib, minimal 32 karakter. Buat dengan: openssl rand -hex 32
SESSION_SECRET=

# --- Login (B-27) ---
# identity-platform (BAWAAN, dipakai produksi) | stub (khusus pengembangan)
#
# Tidak diisi = identity-platform. Fail-closed: lupa memasang env di lingkungan
# baru berarti login MATI, bukan login terbuka.
#
# AUTH_MODE=stub mencocokkan email ke user aktif TANPA kata sandi. Ia butuh TIGA
# gerbang sekaligus: variabel ini, NODE_ENV != production, dan saklar database
# app.auth_settings.stub_login_enabled (dinyalakan `npm run db:seed:dev` /
# `db:seed:demo`). Suite scripts/at-verify.mjs masuk lewat jalur ini, jadi
# `npm run dev` untuk at:verify harus memakai AUTH_MODE=stub.
AUTH_MODE=stub

# Wajib saat AUTH_MODE=identity-platform. Keduanya dari Google Cloud console:
#   IDENTITY_PLATFORM_PROJECT_ID  = project id GCP (juga dipakai sebagai `aud`)
#   IDENTITY_PLATFORM_API_KEY     = Web API key proyek (publik; dikirim ke
#                                   peramban untuk menukar kata sandi menjadi
#                                   ID token — bukan rahasia, tidak memberi hak
#                                   apa pun tanpa kredensial pengguna)
IDENTITY_PLATFORM_PROJECT_ID=
IDENTITY_PLATFORM_API_KEY=

# --- Storage bukti (struk/invoice) ---
# Kosongkan untuk penyimpanan lokal (default: <cwd>/.evidence).
GCS_BUCKET_EVIDENCE=
# LOCAL_EVIDENCE_DIR=/var/www/agrovision/.evidence

# --- Peta ---
# Basemap gratis. Sentinel-2 (ESA Copernicus) -- lisensi terbuka.
NEXT_PUBLIC_BASEMAP_STYLE_URL=
